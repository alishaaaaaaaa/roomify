# Copy this file to .env and fill in your own values.
# Never commit the real .env file - it's already in .gitignore.

# Your store's domain, e.g. your-store-name.myshopify.com
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# The PRIVATE access token from Headless channel -> Add storefront -> Create storefront
# Keep this secret - it's only used on the server, never sent to the browser.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The Storefront API version to target (update periodically)
SHOPIFY_STOREFRONT_API_VERSION=2026-01

# --- Only needed for `npm run generate-models` (not the app itself) ---
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=shpss_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MESHY_API_KEY=msy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
